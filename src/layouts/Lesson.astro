---
// Lesson layout — article shell for one lesson: tier badge + title + meta row,
// two-column grid (content / TOC sidebar), completion checkbox, prev/next nav.
// Content is the MDX body; headings come from the Render result.
import Base from "./Base.astro";
import TierBadge from "../components/TierBadge.astro";
import Toc from "../components/Toc.astro";
import LessonCheckbox from "../components/LessonCheckbox.astro";
import LessonNav from "../components/LessonNav.astro";

type Tier = "beginner" | "intermediate" | "advanced";

interface NavEntry {
  title: string;
  href: string;
  tier: Tier;
}

interface Props {
  lang: string;
  slug: string; // full lesson slug, e.g. "beginner/01-hello"
  tier: Tier;
  title: string;
  description?: string;
  estimatedMinutes?: number;
  prev?: NavEntry;
  next?: NavEntry;
  headings?: { depth: number; slug: string; text: string }[];
}

const { lang, slug, tier, title, description, estimatedMinutes, prev, next, headings = [] } = Astro.props;

const base = import.meta.env.BASE_URL;
---

<Base title={`${title} — ${lang} — Programming Tutorial`} description={description}>
  <article class="mx-auto max-w-6xl px-4 py-8">
    <header>
      <div class="flex flex-wrap items-center gap-2">
        <a href={`${base}learn/${lang}/`} class="text-sm text-muted hover:text-text hover:underline">
          ← {lang[0]?.toUpperCase()}
          {lang.slice(1)} track
        </a>
        <TierBadge tier={tier} />
      </div>
      <h1 class="mt-3 text-3xl font-bold tracking-tight">{title}</h1>
      {description && <p class="mt-2 max-w-2xl text-muted">{description}</p>}
      {estimatedMinutes && (
        <p class="mt-2 text-sm text-muted">
          Estimated time: {estimatedMinutes} min
        </p>
      )}
    </header>

    <div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_240px]">
      <div class="min-w-0">
        <!-- pt-article: content typography for the MDX body (see global.css);
             scoped to the slot so checkbox/nav chrome keeps its own classes. -->
        <div class="pt-article">
          <slot />
        </div>

        <div class="mt-8 border-t border-border pt-4">
          <LessonCheckbox id={`${lang}/${slug}`} />
        </div>
        <LessonNav prev={prev} next={next} />
      </div>
      <aside class="hidden lg:block">
        <div class="sticky top-20">
          <Toc headings={headings} />
        </div>
      </aside>
    </div>
  </article>
</Base>
