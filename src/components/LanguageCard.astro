---
// LanguageCard — directory card for one language. Links to the track hub when a
// full track exists, otherwise to the encyclopedia page (when written), otherwise
// renders as a plain entry (roadmap/planned). Hover lift is gated behind
// prefers-reduced-motion in global.css.
interface Props {
  name: string;
  slug?: string;
  paradigms?: string[];
  year?: number;
  status?: "active" | "legacy" | "historical";
  hasTrack?: boolean;
}

const { name, slug, paradigms = [], year, status = "active", hasTrack = false } = Astro.props;

const base = import.meta.env.BASE_URL;
const href = hasTrack && slug ? `${base}learn/${slug}/` : slug ? `${base}languages/${slug}/` : undefined;

const statusStyles: Record<NonNullable<Props["status"]>, string> = {
  active: "bg-success/15 text-success",
  legacy: "bg-surface-alt text-muted",
  historical: "bg-surface-alt text-muted"
};
---

{href ? (
  <a href={href} class="pt-card-lift block rounded-lg border border-border bg-surface p-4 hover:border-accent">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-semibold text-text">{name}</h3>
      {hasTrack && (
        <span class="rounded-full bg-accent px-2 py-0.5 text-[11px] font-semibold text-on-accent">Full track</span>
      )}
    </div>
    <p class="mt-1 text-sm text-muted">
      {paradigms.length > 0 && <span>{paradigms.join(" · ")}</span>}
      {year && <span>{paradigms.length > 0 ? " · " : ""}{year}</span>}
    </p>
    {status !== "active" && (
      <span class={`mt-2 inline-flex rounded-full px-2 py-0.5 text-[11px] font-medium capitalize ${statusStyles[status]}`}>{status}</span>
    )}
  </a>
) : (
  <div class="block rounded-lg border border-border bg-surface p-4">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-semibold text-text">{name}</h3>
      <span class="rounded-full bg-surface-alt px-2 py-0.5 text-[11px] font-medium text-muted">Planned</span>
    </div>
    <p class="mt-1 text-sm text-muted">
      {paradigms.length > 0 && <span>{paradigms.join(" · ")}</span>}
      {year && <span>{paradigms.length > 0 ? " · " : ""}{year}</span>}
    </p>
  </div>
)}
