---
// Toc — "On this page" table of contents with IntersectionObserver scrollspy.
// Headings come from the page (Astro Render result `headings` or a manual list).
// The active link gets aria-current="location"; links are plain anchors so the
// widget is fully keyboard-accessible without extra scripting.
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

{headings.length > 0 && (
  <nav data-toc aria-label="On this page" class="text-sm">
    <p class="text-xs font-semibold uppercase tracking-wide text-muted">On this page</p>
    <ul class="mt-2 space-y-1 border-l border-border">
      {headings.map((heading) => (
        <li style={`padding-left: ${Math.max(0, heading.depth - 2) * 0.75}rem`}>
          <a href={`#${heading.slug}`} data-toc-link={heading.slug} class="pt-toc-link -ml-px block border-l-2 border-transparent py-0.5 pl-3 text-muted hover:text-text">
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  for (const nav of document.querySelectorAll<HTMLElement>("[data-toc]")) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    const order = links.map((link) => link.dataset.tocLink as string);

    const setActive = (slug: string | null) => {
      for (const link of links) {
        const active = link.dataset.tocLink === slug;
        link.classList.toggle("pt-toc-active", active);
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    };

    const visible: string[] = [];
    // At the bottom of the page a short final section can sit below the spy
    // band, so pin its heading active there; otherwise the first heading
    // inside the band wins.
    const refresh = () => {
      const atBottom = window.scrollY > 0 && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      if (atBottom) setActive(order[order.length - 1]);
      else setActive(order.find((slug) => visible.includes(slug)) ?? null);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const slug = (entry.target as HTMLElement).id;
          const idx = visible.indexOf(slug);
          if (entry.isIntersecting && idx === -1) visible.push(slug);
          else if (!entry.isIntersecting && idx !== -1) visible.splice(idx, 1);
        }
        refresh();
      },
      { rootMargin: "-80px 0px -60% 0px", threshold: 0 }
    );

    for (const slug of order) {
      const el = document.getElementById(slug);
      if (el) observer.observe(el);
    }

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          refresh();
        });
      },
      { passive: true }
    );
  }
</script>
