---
// Header/Nav — site title, primary nav, track-language switcher (prop-driven),
// search trigger opening a Pagefind dialog, and the theme toggle. Internal link
// hrefs are passed base-relative (no leading slash) and prefixed with the site base
// automatically; absolute http(s) links pass through unchanged.
import ThemeToggle from "./ThemeToggle.astro";
import SearchBar from "./SearchBar.astro";

interface NavLink {
  label: string;
  href: string;
}

interface LangOption {
  label: string;
  href: string;
}

interface Props {
  links?: NavLink[];
  languages?: LangOption[];
}

const {
  links = [{ label: "Design system", href: "docs/design-system/" }],
  languages = []
} = Astro.props;

const base = import.meta.env.BASE_URL;

function resolveHref(href: string) {
  return href.startsWith("http") ? href : `${base}${href.replace(/^\//, "")}`;
}
---

<header class="sticky top-0 z-40 border-b border-border bg-surface">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-3 gap-y-2 px-4 py-2">
    <a href={base} class="flex items-center gap-2 font-bold text-text" aria-label="Programming Tutorial — home">
      <img src={`${base}favicon.svg`} alt="" class="h-6 w-6" />
      <span>Programming Tutorial</span>
    </a>

    <nav aria-label="Main" class="flex items-center gap-1">
      {links.map((link) => (
        <a href={resolveHref(link.href)} class="rounded-md px-2.5 py-1.5 text-sm text-muted hover:bg-surface-alt hover:text-text">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      {languages.length > 0 && (
        <label class="flex items-center gap-1.5 text-sm">
          <span class="sr-only">Track language</span>
          <select data-lang-switch class="h-9 rounded-md border border-border bg-surface px-2 text-sm text-text">
            {languages.map((lang) => (
              <option value={resolveHref(lang.href)}>{lang.label}</option>
            ))}
          </select>
        </label>
      )}

      <button
        type="button"
        data-search-open
        class="inline-flex h-9 items-center gap-1.5 rounded-md border border-border bg-surface px-2.5 text-sm text-text hover:bg-surface-alt"
        aria-haspopup="dialog"
        aria-controls="pt-search-dialog"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="hidden sm:inline">Search</span>
      </button>

      <ThemeToggle />
    </div>
  </div>

  <dialog id="pt-search-dialog" aria-label="Search the site" class="m-auto w-full max-w-lg rounded-lg border border-border bg-surface p-0 text-text shadow-xl">
    <div class="flex items-center justify-between gap-2 border-b border-border px-4 py-2.5">
      <h2 class="text-sm font-semibold">Search</h2>
      <button type="button" data-search-close class="rounded-md px-2 py-1 text-sm text-muted hover:bg-surface-alt hover:text-text" aria-label="Close search">
        Close
      </button>
    </div>
    <div class="p-3">
      <SearchBar />
    </div>
  </dialog>

  {import.meta.env.MODE === "production" && (
    <>
      <link rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
      <script src={`${base}pagefind/pagefind-ui.js`}></script>
    </>
  )}
</header>

<script>
  const dialog = document.getElementById("pt-search-dialog") as HTMLDialogElement | null;

  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-search-open]")) {
    btn.addEventListener("click", () => dialog?.showModal());
  }

  const closeBtn = document.querySelector<HTMLButtonElement>("[data-search-close]");
  closeBtn?.addEventListener("click", () => dialog?.close());

  for (const select of document.querySelectorAll<HTMLSelectElement>("[data-lang-switch]")) {
    select.addEventListener("change", () => {
      if (select.value) window.location.assign(select.value);
    });
  }
</script>
