---
// PublishedLessons — per-language, per-tier link list of published lessons, built
// from committed curriculum JSON at build time. Links follow the lesson URL
// convention /learn/<lang>/<tier>/<NN>-<slug>/ (docs/content-conventions.md) and
// go live when the track hub routes ship; until then they are pre-wired.
type Tier = "beginner" | "intermediate" | "advanced";

interface LessonLink {
  order: number;
  slug: string;
  title: string;
}

interface TierGroup {
  tier: Tier;
  lessons: LessonLink[];
}

interface LangGroup {
  lang: string;
  done: number;
  total: number;
  tiers: TierGroup[];
}

interface Props {
  languages: LangGroup[];
}

const { languages } = Astro.props;
const base = import.meta.env.BASE_URL;
---

{languages.length > 0 ? (
  <div class="space-y-4">
    {languages.map((g) => (
      <div class="rounded-lg border border-border bg-surface p-4">
        <h3 class="font-semibold capitalize">
          {g.lang}
          <span class="ml-2 text-sm font-normal text-muted">{g.done}/{g.total} published</span>
        </h3>
        {g.tiers.map((t) => (
          <div class="mt-3">
            <h4 class="text-xs uppercase tracking-wide text-muted capitalize">{t.tier}</h4>
            <ul class="mt-1 grid gap-x-6 gap-y-1 sm:grid-cols-2">
              {t.lessons.map((l) => (
                <li class="truncate">
                  <a
                    href={`${base}learn/${g.lang}/${t.tier}/${String(l.order).padStart(2, "0")}-${l.slug}/`}
                    class="text-sm text-text underline decoration-accent underline-offset-2 hover:opacity-80"
                  >
                    {String(l.order).padStart(2, "0")} · {l.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ))}
  </div>
) : (
  <p class="rounded-md border border-border bg-surface p-4 text-sm text-muted">No published lessons yet.</p>
)}
