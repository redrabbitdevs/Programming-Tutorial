---
// Footer — copyright line plus secondary links (design system reference, public
// pipeline dashboard, source repo). The dashboard route lands in Phase 2; the link
// is part of the shell from day one per the plan.
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} Programming Tutorial. Content under the MIT license unless a lesson notes otherwise.</p>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-4 gap-y-1">
      <a href={`${base}docs/design-system/`} class="hover:text-text hover:underline">Design system</a>
      <a href={`${base}dashboard/`} class="hover:text-text hover:underline">Pipeline dashboard</a>
      <a href="https://github.com/redrabbitdevs/Programming-Tutorial" rel="noopener" class="hover:text-text hover:underline">Source</a>
    </nav>
  </div>
</footer>
