---
// Home — hero + entry points. The full language directory and featured tracks are
// populated as curriculum/encyclopedia data lands (Phases 4–6); until then this is
// the branded shell on the Base layout.
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
---

<Base>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
    <section class="pt-fade-up max-w-3xl">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Learn programming, end to end.</h1>
      <p class="mt-4 text-lg text-muted">
        Beginner-to-advanced tracks for every major language — code samples validated in CI, progress saved on your device, and a
        900+ language encyclopedia.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`${base}docs/design-system/`} class="rounded-md bg-accent px-4 py-2 text-sm font-semibold text-on-accent hover:opacity-90">
          Design system
        </a>
        <a href={`${base}dashboard/`} class="rounded-md border border-border bg-surface px-4 py-2 text-sm font-semibold text-text hover:bg-surface-alt">
          Pipeline dashboard
        </a>
      </div>
    </section>

    <section class="pt-fade-up mt-16" aria-labelledby="tracks-h">
      <h2 id="tracks-h" class="text-xl font-semibold">Tracks</h2>
      <p class="mt-2 max-w-2xl text-sm text-muted">
        Full beginner → intermediate → advanced tracks ship as each language completes the pipeline. The Python track is first —
        more languages follow in TIOBE order.
      </p>
    </section>
  </div>
</Base>
